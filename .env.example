# Copy this file to BOTH `.env` and `.env.local` (both are git-ignored):
#   - `.env` is read by the Prisma CLI (validate/format/generate/migrate)
#   - `.env.local` is read by Next.js at runtime (and overrides `.env` for the dev server)
# Keep the two in sync when you change a value.
#
#   cp .env.example .env
#   cp .env.example .env.local

# Database (must match the credentials in docker-compose.yml)
DATABASE_URL=postgresql://homegoods:homegoods123@localhost:5432/home_goods_db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Environment
NODE_ENV=development

# LocalStack (Optional - for AWS services simulation)
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
